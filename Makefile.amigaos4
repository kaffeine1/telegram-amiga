CC ?= ppc-amigaos-gcc
CFLAGS ?= -Wall -Wextra -O2 -Iinclude
SDK_INCLUDE ?= SDK:include/include_h
SDK_NETINCLUDE ?= SDK:include/netinclude
TARGET ?= build/TelegramAmiga
BUILD_DIR := $(dir $(TARGET))
OBJ_DIR ?= $(TARGET).obj
SRC := src/main.c core/tg_app.c core/tg_bot.c core/tg_config.c core/tg_console.c core/tg_console_ui.c core/tg_console_tui.c core/tg_gui.c core/tg_gui_window.c core/tg_chat_engine.c core/tg_gui_driver.c core/tg_client_state.c core/tg_offset_state.c core/tg_text_client.c core/tg_file.c core/tg_http.c core/tg_https.c core/tg_json.c core/tg_telegram.c core/tg_log.c core/tg_mtproto.c core/tg_mtproto_auth.c core/tg_mtproto_bigint.c core/tg_mtproto_dc.c core/tg_mtproto_envelope.c core/tg_mtproto_encrypted.c core/tg_mtproto_login.c core/tg_mtproto_message_id.c core/tg_mtproto_probe.c core/tg_mtproto_rsa.c core/tg_mtproto_crypto.c core/tg_mtproto_session.c core/tg_mtproto_srp.c core/tg_mtproto_tl.c core/tg_mtproto_transport.c core/tg_net.c core/tg_tls.c platforms/amigaos4/tg_platform_amigaos4.c
OBJ := $(patsubst %.c,$(OBJ_DIR)/%.o,$(SRC))
HEADERS := include/tg_app.h include/tg_bot.h include/tg_config.h include/tg_console.h include/tg_console_ui.h include/tg_console_tui.h include/tg_client_state.h include/tg_offset_state.h include/tg_text_client.h include/tg_file.h include/tg_http.h include/tg_https.h include/tg_json.h include/tg_telegram.h include/tg_log.h include/tg_mtproto.h include/tg_mtproto_auth.h include/tg_mtproto_bigint.h include/tg_mtproto_dc.h include/tg_mtproto_envelope.h include/tg_mtproto_encrypted.h include/tg_mtproto_login.h include/tg_mtproto_message_id.h include/tg_mtproto_probe.h include/tg_mtproto_rsa.h include/tg_mtproto_crypto.h include/tg_mtproto_session.h include/tg_mtproto_srp.h include/tg_mtproto_tl.h include/tg_mtproto_transport.h include/tg_net.h include/tg_platform.h include/tg_tls.h include/tg_gui.h
ENABLE_AMISSL ?= 0
ENABLE_GZIP ?= 0
ENABLE_GZIP_PUFF ?= 1
AMISSL_LIB ?= amisslstubs
AMISSL_LIBDIR ?=

CFLAGS += -I$(SDK_INCLUDE) -I$(SDK_NETINCLUDE)

ifeq ($(ENABLE_AMISSL),1)
CFLAGS += -DTG_AMIGAOS4_ENABLE_AMISSL=1
ifneq ($(AMISSL_LIBDIR),)
LDFLAGS += -L$(AMISSL_LIBDIR)
endif
LDLIBS += -l$(AMISSL_LIB)
endif

ifeq ($(ENABLE_GZIP),1)
CFLAGS += -DTG_ENABLE_GZIP=1
LDLIBS += -lz
endif

ifeq ($(ENABLE_GZIP_PUFF),1)
CFLAGS += -DTG_ENABLE_GZIP_PUFF=1 -Ithird_party/puff
SRC += core/tg_avatar.c core/tg_emoji_sheet.c third_party/tjpgd/tjpgd.c third_party/puff/puff.c
OBJ += $(OBJ_DIR)/core/tg_avatar.o $(OBJ_DIR)/third_party/tjpgd/tjpgd.o $(OBJ_DIR)/third_party/puff/puff.o
HEADERS += third_party/puff/puff.h
endif

# Release lanes ship without the offline self-tests (decision 2026-08-07):
# CI runs the full suite on the host binary, so on an Amiga they are only
# dead weight (roughly 15 percent of the binary). NO_SELFTEST=0 compiles
# them back in for a debugging build. The field diagnostics (--net-test,
# --http-test, --https-test, --platform-rng-test, --mtproto-2fa-bench)
# are always compiled in either way.
NO_SELFTEST ?= 1
ifeq ($(NO_SELFTEST),1)
CFLAGS += -DTG_NO_SELFTEST=1
endif

# tg_chat_engine.h carries the per-platform chat-list cap (TG_CHAT_LIST_MAX);
# without it in HEADERS a per-object incremental build after a cap change leaves
# stale .o with mismatched struct offsets. (clean all stays the safe default.)
HEADERS += include/tg_chat_engine.h

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJ)
	mkdir -p $(BUILD_DIR)
	$(CC) $(LDFLAGS) -o $@ $(OBJ) $(LDLIBS)
	@strings "$@" | grep -F '$$STACK:1048576' >/dev/null || { \
		echo "ERROR: $@ is missing the 1 MiB AmigaDOS stack cookie" >&2; \
		rm -f "$@"; exit 1; \
	}

HDRS_ALL := $(wildcard include/*.h) $(wildcard third_party/*/*.h)
$(OBJ_DIR)/%.o: %.c $(HEADERS) $(HDRS_ALL)
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(TARGET) $(OBJ)
